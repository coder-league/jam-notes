# Copy this file to .env.local for local testing. On Vercel, add the same
# names under Project > Settings > Environment Variables.

# Spotify developer app (developer.spotify.com > your app > Settings)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional. Leave blank and the app uses <your site>/callback automatically.
SPOTIFY_REDIRECT_URI=

# Supabase (Project Settings > API Keys, and the Project URL)
SUPABASE_URL=https://xxxxxxxx.supabase.co
# The SECRET key (sb_secret_...). Server only, never shared.
SUPABASE_SECRET_KEY=

# Personal link keys. Generate with: npm run keys
KEY_OM=
KEY_GISELE=

# Display names
NAME_OM=Om
NAME_GISELE=Gisele
